# Copy this to .env and fill in your values.
# Never commit .env to git.

# LCO API token (get from https://observe.lco.global/accounts/profile/)
LCO_API_TOKEN=

# Override config file location (optional)
# AVA_CONFIG=/path/to/my_ava_config.yaml

# PostgreSQL password (only needed if engine=postgresql in config)
# AVA_DB_PASSWORD=

# Flask secret key (run: python -c "import secrets; print(secrets.token_hex())")
# AVA_SECRET_KEY=
